      "parameters": {
        "jsCode": "const idEstudiante = $('Buscar Estudiante').item.json.id_estudiante;\nconst activas = ['Solicitada', 'Asignada', 'Confirmada'];\nconst dias = ['Domingo','Lunes','Martes','Miercoles','Jueves','Viernes','Sabado'];\nconst lista = $input.all()\n  .filter(i => String(i.json.id_estudiante) === String(idEstudiante) && activas.includes(i.json.estado))\n  .map(i => {\n    const fecha = new Date(i.json.fecha + 'T00:00:00');\n    return {\n      row_number_tutoria: i.json.row_number,\n      id_tutoria: i.json.id_tutoria,\n      materia: i.json.materia,\n      id_tutor: i.json.id_tutor,\n      fecha: i.json.fecha,\n      hora: i.json.hora,\n      dia_semana: dias[fecha.getDay()],\n      estado: i.json.estado\n    };\n  });\nreturn [{ json: { lista, hay_tutorias: lista.length > 0 } }];"
      },
