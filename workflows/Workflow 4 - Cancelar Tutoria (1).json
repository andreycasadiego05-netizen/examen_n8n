      "parameters": {
        "jsCode": "// Valida que mensaje_usuario sea un numero dentro del rango de la lista guardada\nconst datos = $('Parsear Datos Parciales').item.json.datos;\nconst lista = datos.lista || [];\nconst raw = ($('Parsear Datos Parciales').item.json.mensaje_usuario || '').trim();\nconst idx = parseInt(raw, 10) - 1;\nconst valido = Number.isInteger(idx) && idx >= 0 && idx < lista.length;\nreturn { json: { valido, seleccion: valido ? lista[idx] : null } };"
      },
