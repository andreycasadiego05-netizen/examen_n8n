    {
      "parameters": {
        "jsCode": "const tutorias = $('Leer Tutorias').all().map(i => i.json);\nconst tutores = $input.all().map(i => i.json);\nconst nombrePorId = {};\ntutores.forEach(t => { nombrePorId[t.id_tutor] = t.nombre; });\n\nconst total = tutorias.length;\nconst porEstado = {};\ntutorias.forEach(f => { porEstado[f.estado] = (porEstado[f.estado] || 0) + 1; });\n\nconst porMateria = {};\ntutorias.forEach(f => { porMateria[f.materia] = (porMateria[f.materia] || 0) + 1; });\n\nconst porTutor = {};\ntutorias.forEach(f => {\n  const nombre = nombrePorId[f.id_tutor] || f.id_tutor;\n  if (!porTutor[nombre]) porTutor[nombre] = {};\n  porTutor[nombre][f.estado] = (porTutor[nombre][f.estado] || 0) + 1;\n});\n\nconst filaEstado = Object.entries(porEstado).map(([k, v]) => `<li>${k}: ${v}</li>`).join('');\nconst filaMateria = Object.entries(porMateria).map(([k, v]) => `<li>${k}: ${v}</li>`).join('');\nconst filaTutor = Object.entries(porTutor).map(([nombre, estados]) => {\n  const detalle = Object.entries(estados).map(([e, c]) => `${e}: ${c}`).join(', ');\n  return `<li>${nombre} - ${detalle}</li>`;\n}).join('');\n\nconst hoy = new Date().toISOString().slice(0, 10);\n\nconst html = `\n<h2>Reporte semanal TutorBot - ${hoy}</h2>\n<p>Total de tutorias registradas hasta la fecha: <strong>${total}</strong></p>\n<h3>Por estado</h3>\n<ul>${filaEstado || '<li>Sin datos</li>'}</ul>\n<h3>Por materia</h3>\n<ul>${filaMateria || '<li>Sin datos</li>'}</ul>\n<h3>Por tutor</h3>\n<ul>${filaTutor || '<li>Sin datos</li>'}</ul>\n`;\n\nreturn [{ json: { html, total, fecha: hoy } }];"
      },
