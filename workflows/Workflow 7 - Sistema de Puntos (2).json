    {
      "parameters": {
        "jsCode": "const PUNTOS_POR_SESION = 10;\n\nconst tutorias = $('Leer Tutorias').all().map(i => i.json);\nconst estudiantes = $input.all().map(i => i.json);\n\nconst estudiantePorId = {};\nestudiantes.forEach(e => { estudiantePorId[e.id_estudiante] = e; });\n\nconst resultados = [];\ntutorias.forEach(t => {\n  if ((t.estado || '').trim() !== 'Finalizada') return;\n\n  const estudiante = estudiantePorId[t.id_estudiante];\n  if (!estudiante) return;\n\n  const puntosActuales = Number(estudiante.puntos) || 0;\n  const puntosNuevos = puntosActuales + PUNTOS_POR_SESION;\n\n  resultados.push({\n    id_tutoria: t.id_tutoria,\n    id_estudiante: estudiante.id_estudiante,\n    telegram_user: estudiante.telegram_user,\n    nombre_estudiante: estudiante.nombre || '',\n    puntos_ganados: PUNTOS_POR_SESION,\n    puntos_nuevos: puntosNuevos\n  });\n});\n\nreturn resultados.map(r => ({ json: r }));"
      },
